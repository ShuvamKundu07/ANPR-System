# ── ANPR Configuration ──────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your machine.
# .env is excluded from git and must NEVER contain credentials or real data.

# Path to the YOLO license-plate detection weight file (.pt)
MODEL_PATH=models/license_plate_detector.pt

# Minimum YOLO detection confidence (0.0 – 1.0)
DETECTOR_CONFIDENCE=0.4

# Default webcam device index (integer, 0 = first camera)
DEFAULT_CAMERA_ID=0

# Directory where cropped plate images are saved
CROP_DIR=data/plate_crops

# SQLite database file path
DB_PATH=data/anpr.db

# Seconds to suppress duplicate observations for the same plate+camera pair
DUPLICATE_WINDOW_SEC=30

# Minimum EasyOCR confidence to accept a reading (0.0 – 1.0)
OCR_CONFIDENCE_THRESHOLD=0.3

# Simulated camera IDs used in the two-camera demo (Phase 9)
CAM_ID_1=CAM001
CAM_ID_2=CAM002
